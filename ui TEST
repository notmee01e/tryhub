-- Fluent Lite - Full Working Version with Draggable + Minimizer + Proper Dropdown
-- March 2025

local Library = {
    Theme   = "Dark",
    GUI     = Instance.new("ScreenGui", game:GetService("Players").LocalPlayer:WaitForChild("PlayerGui")),
    Windows = {},
    OpenDropdowns = {}, -- to close when clicking elsewhere
}

Library.GUI.ResetOnSpawn = false
Library.GUI.Name = "FluentLite"

local Themes = {
    Dark = {
        Accent        = Color3.fromRGB(100, 180, 255),
        Background    = Color3.fromRGB(22, 22, 28),
        Element       = Color3.fromRGB(32, 32, 38),
        Border        = Color3.fromRGB(60, 60, 75),
        Text          = Color3.fromRGB(235, 235, 245),
        SubText       = Color3.fromRGB(160, 160, 180),
        Hover         = Color3.fromRGB(45, 45, 55),
        DropdownBg    = Color3.fromRGB(25, 25, 32),
    }
}

local ts = game:GetService("TweenService")
local uis = game:GetService("UserInputService")

local function New(class, props, children)
    local o = Instance.new(class)
    for k,v in pairs(props or {}) do
        if k ~= "Parent" then o[k] = v end
    end
    for _,c in ipairs(children or {}) do c.Parent = o end
    if props and props.Parent then o.Parent = props.Parent end
    return o
end

local function Tween(obj, info, goals)
    ts:Create(obj, info or TweenInfo.new(0.25, Enum.EasingStyle.Quint), goals):Play()
end

local function ApplyTheme(obj, props)
    local t = Themes[Library.Theme] or Themes.Dark
    for p,c in pairs(props or {}) do
        if t[c] then obj[p] = t[c] end
    end
end

-- Simple element base (used by all controls)
local function CreateElement(title, desc, parent)
    local frame = New("TextButton", {
        Size = UDim2.new(1,0,0,0),
        AutoButtonColor = false,
        BackgroundTransparency = 0.92,
        Parent = parent,
    }, {
        New("UICorner", {CornerRadius = UDim.new(0,6)}),
        New("UIStroke", {Transparency=0.65, ApplyStrokeMode = Enum.ApplyStrokeMode.Border}),
    })

    ApplyTheme(frame,      {BackgroundColor3="Element"})
    ApplyTheme(frame.UIStroke, {Color="Border"})

    local holder = New("Frame", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1,-16,1,0),
        Position = UDim2.fromOffset(8,0),
        Parent = frame
    }, {
        New("UIListLayout", {Padding = UDim.new(0,4), SortOrder = Enum.SortOrder.LayoutOrder})
    })

    local lblTitle = New("TextLabel", {
        Text = title or "",
        Font = Enum.Font.GothamSemibold,
        TextSize = 14,
        BackgroundTransparency = 1,
        Size = UDim2.new(1,0,0,20),
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = holder,
    })

    local lblDesc = New("TextLabel", {
        Text = desc or "",
        Font = Enum.Font.Gotham,
        TextSize = 12,
        TextColor3 = Color3.fromRGB(170,170,190),
        BackgroundTransparency = 1,
        Size = UDim2.new(1,0,0,0),
        AutomaticSize = Enum.AutomaticSize.Y,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextWrapped = true,
        Parent = holder,
    })

    ApplyTheme(lblTitle, {TextColor3="Text"})
    ApplyTheme(lblDesc,  {TextColor3="SubText"})

    -- Hover/click feedback
    frame.MouseEnter:Connect(function()
        Tween(frame, nil, {BackgroundTransparency = 0.82})
        Tween(frame.UIStroke, nil, {Transparency = 0.4})
    end)
    frame.MouseLeave:Connect(function()
        Tween(frame, nil, {BackgroundTransparency = 0.92})
        Tween(frame.UIStroke, nil, {Transparency = 0.65})
    end)

    frame.Size = UDim2.new(1,0,0, holder.UIListLayout.AbsoluteContentSize.Y + 16)

    return {
        Frame    = frame,
        SetTitle = function(t) lblTitle.Text = t end,
        SetDesc  = function(d) lblDesc.Text = d end,
        Visible  = function(v) frame.Visible = v end,
    }
end

-- Window
local function CreateWindow(cfg)
    local win = {
        Title = cfg.Title or "Fluent Lite",
        Minimized = false,
        Root = nil,
    }

    local root = New("Frame", {
        Size = cfg.Size or UDim2.fromOffset(560, 380),
        Position = UDim2.new(0.5, -280, 0.5, -190),
        BackgroundColor3 = Color3.fromRGB(20,20,26),
        ClipsDescendants = true,
        Parent = Library.GUI,
    }, {
        New("UICorner", {CornerRadius = UDim.new(0,10)}),
        New("UIStroke", {Color = Color3.fromRGB(50,50,70), Thickness = 1.5, Transparency = 0.4}),
    })

    win.Root = root

    -- Title bar
    local titleBar = New("Frame", {Size = UDim2.new(1,0,0,36), BackgroundTransparency = 1, Parent = root})

    New("TextLabel", {
        Text = win.Title,
        Font = Enum.Font.GothamBold,
        TextSize = 15,
        TextColor3 = Color3.new(1,1,1),
        BackgroundTransparency = 1,
        Size = UDim2.new(1,-80,1,0),
        Position = UDim2.fromOffset(14,0),
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = titleBar,
    })

    local minimizeBtn = New("TextButton", {
        Size = UDim2.fromOffset(28,28),
        Position = UDim2.new(1,-66,0,4),
        BackgroundTransparency = 0.9,
        Text = "−",
        Font = Enum.Font.GothamBold,
        TextSize = 18,
        TextColor3 = Color3.fromRGB(180,220,255),
        Parent = titleBar,
    }, {New("UICorner", {CornerRadius=UDim.new(0,6)})})

    local closeBtn = New("TextButton", {
        Size = UDim2.fromOffset(28,28),
        Position = UDim2.new(1,-34,0,4),
        BackgroundTransparency = 0.9,
        Text = "×",
        Font = Enum.Font.GothamBold,
        TextSize = 18,
        TextColor3 = Color3.fromRGB(255,100,100),
        Parent = titleBar,
    }, {New("UICorner", {CornerRadius=UDim.new(0,6)})})

    -- Dragging
    local dragging, dragInput, dragStart, startPos
    titleBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = root.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then dragging = false end
            end)
        end
    end)

    titleBar.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)

    uis.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            root.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)

    -- Minimize / Restore (title bar)
    local originalSize = root.Size
    local originalPos  = root.Position
    minimizeBtn.MouseButton1Click:Connect(function()
        win.Minimized = not win.Minimized
        if win.Minimized then
            Tween(root, TweenInfo.new(0.3,Enum.EasingStyle.Back,Enum.EasingDirection.In), {
                Size = UDim2.fromOffset(0,0),
                Position = UDim2.new(0.5,-30,0.9,-30)
            })
        else
            Tween(root, TweenInfo.new(0.4,Enum.EasingStyle.Back,Enum.EasingDirection.Out), {
                Size = originalSize,
                Position = originalPos
            })
        end
    end)

    closeBtn.MouseButton1Click:Connect(function()
        Library.GUI:Destroy()
    end)

    -- Tab system
    local tabBar = New("Frame", {
        Size = UDim2.new(0,140,1,-44),
        Position = UDim2.fromOffset(12,40),
        BackgroundTransparency = 1,
        Parent = root
    }, {New("UIListLayout", {Padding = UDim.new(0,6)})})

    local contentArea = New("ScrollingFrame", {
        Size = UDim2.new(1,-164,1,-50),
        Position = UDim2.fromOffset(152,44),
        BackgroundTransparency = 1,
        ScrollBarThickness = 3,
        CanvasSize = UDim2.new(),
        Parent = root
    }, {
        New("UIListLayout", {Padding = UDim.new(0,10), SortOrder = Enum.SortOrder.LayoutOrder}),
        New("UIPadding", {PaddingLeft = UDim.new(0,6), PaddingRight = UDim.new(0,10)})
    })

    local tabs = {}

    function win:AddTab(name)
        local tab = {}

        local btn = New("TextButton", {
            Size = UDim2.new(1,0,0,34),
            BackgroundTransparency = 0.9,
            Text = name,
            Font = Enum.Font.GothamSemibold,
            TextSize = 13,
            TextColor3 = Color3.new(1,1,1),
            Parent = tabBar,
        }, {New("UICorner", {CornerRadius = UDim.new(0,6)})})

        local container = New("Frame", {
            Size = UDim2.fromScale(1,1),
            BackgroundTransparency = 1,
            Visible = false,
            Parent = contentArea
        }, {New("UIListLayout", {Padding = UDim.new(0,8), SortOrder = Enum.SortOrder.LayoutOrder})})

        btn.MouseButton1Click:Connect(function()
            for _,t in pairs(tabs) do
                t.btn.BackgroundTransparency = 0.9
                t.container.Visible = false
            end
            btn.BackgroundTransparency = 0.75
            container.Visible = true
        end)

        tab.btn = btn
        tab.container = container
        table.insert(tabs, tab)

        if #tabs == 1 then
            btn.BackgroundTransparency = 0.75
            container.Visible = true
        end

        local api = {}

        function api:Button(cfg)
            local el = CreateElement(cfg.Text or "Button", cfg.Desc or "", container)
            el.Frame.MouseButton1Click:Connect(cfg.Callback or function() end)
            return el
        end

        function api:Toggle(cfg)
            local el = CreateElement(cfg.Text or "Toggle", cfg.Desc or "", container)
            local tog = New("Frame", {
                Size = UDim2.fromOffset(36,18),
                AnchorPoint = Vector2.new(1,0.5),
                Position = UDim2.new(1,-12,0.5,0),
                BackgroundColor3 = Color3.fromRGB(55,55,65),
                Parent = el.Frame,
            }, {New("UICorner", {CornerRadius=UDim.new(1,0)})})

            local circle = New("Frame", {
                Size = UDim2.fromOffset(14,14),
                Position = UDim2.fromOffset(2,2),
                BackgroundColor3 = Color3.new(1,1,1),
                Parent = tog,
            }, {New("UICorner", {CornerRadius=UDim.new(1,0)})})

            local value = cfg.Default or false

            local function update()
                Tween(circle, TweenInfo.new(0.28,Enum.EasingStyle.Quint), {
                    Position = value and UDim2.fromOffset(20,2) or UDim2.fromOffset(2,2)
                })
                Tween(tog, TweenInfo.new(0.28), {
                    BackgroundColor3 = value and Color3.fromRGB(60,200,120) or Color3.fromRGB(55,55,65)
                })
            end
            update()

            el.Frame.MouseButton1Click:Connect(function()
                value = not value
                update()
                if cfg.Callback then cfg.Callback(value) end
            end)

            return {Value = function() return value end}
        end

        function api:Slider(cfg)
            local el = CreateElement(cfg.Text or "Slider", cfg.Desc or "", container)
            local rail = New("Frame", {
                Size = UDim2.new(1,-24,0,6),
                Position = UDim2.new(0,12,1,-18),
                BackgroundColor3 = Color3.fromRGB(50,50,60),
                Parent = el.Frame,
            }, {New("UICorner", {CornerRadius=UDim.new(1,0)})})

            local fill = New("Frame", {
                Size = UDim2.new(0.5,0,1,0),
                BackgroundColor3 = Color3.fromRGB(90,180,255),
                Parent = rail,
            }, {New("UICorner", {CornerRadius=UDim.new(1,0)})})

            local label = New("TextLabel", {
                Size = UDim2.fromOffset(60,16),
                Position = UDim2.new(1,-70,0,-20),
                BackgroundTransparency = 1,
                Text = tostring(cfg.Default or 50),
                TextColor3 = Color3.new(1,1,1),
                Font = Enum.Font.Gotham,
                TextSize = 12,
                Parent = el.Frame,
            })

            local value = cfg.Default or 50
            local min, max = cfg.Min or 0, cfg.Max or 100
            local dragging = false

            rail.InputBegan:Connect(function(inp)
                if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
                    dragging = true
                end
            end)

            rail.InputEnded:Connect(function(inp)
                if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
                    dragging = false
                end
            end)

            uis.InputChanged:Connect(function(inp)
                if dragging and (inp.UserInputType == Enum.UserInputType.MouseMovement or inp.UserInputType == Enum.UserInputType.Touch) then
                    local relX = math.clamp((inp.Position.X - rail.AbsolutePosition.X) / rail.AbsoluteSize.X, 0, 1)
                    value = math.floor(min + (max - min) * relX)
                    fill.Size = UDim2.new(relX, 0, 1, 0)
                    label.Text = tostring(value)
                    if cfg.Callback then cfg.Callback(value) end
                end
            end)

            return {Value = function() return value end}
        end

        -- ──────────────────────────────────────────────────────────────
        --  Proper Dropdown (like original Fluent)
        -- ──────────────────────────────────────────────────────────────
        function api:Dropdown(cfg)
            local values = cfg.Values or {}
            local default = cfg.Default or (values[1] or "Select...")

            local el = CreateElement(cfg.Text or "Dropdown", cfg.Desc or "", container)

            local display = New("TextButton", {
                Size = UDim2.new(1,-24,0,32),
                Position = UDim2.fromOffset(12,0),
                BackgroundTransparency = 0.85,
                Text = tostring(default),
                TextColor3 = Color3.new(1,1,1),
                Font = Enum.Font.Gotham,
                TextSize = 13,
                Parent = el.Frame,
            }, {
                New("UICorner", {CornerRadius = UDim.new(0,6)}),
                New("TextLabel", {
                    Size = UDim2.fromOffset(16,16),
                    Position = UDim2.new(1,-24,0.5,0),
                    AnchorPoint = Vector2.new(1,0.5),
                    BackgroundTransparency = 1,
                    Text = "▼",
                    TextColor3 = Color3.fromRGB(180,180,200),
                    Font = Enum.Font.GothamBold,
                    TextSize = 14,
                    Parent = nil -- will be added below
                })
            })

            local dropdownFrame = New("Frame", {
                Size = UDim2.new(1,-24,0,0),
                Position = UDim2.new(0,12,1,6),
                BackgroundTransparency = 0.1,
                Visible = false,
                ClipsDescendants = true,
                Parent = el.Frame,
            }, {
                New("UICorner", {CornerRadius = UDim.new(0,6)}),
                New("UIListLayout", {Padding = UDim.new(0,2), SortOrder = Enum.SortOrder.LayoutOrder}),
                New("UIPadding", {PaddingTop = UDim.new(0,4), PaddingBottom = UDim.new(0,4)})
            })

            ApplyTheme(dropdownFrame, {BackgroundColor3 = "DropdownBg"})

            local selectedValue = default

            local function closeDropdown()
                Tween(dropdownFrame, TweenInfo.new(0.22, Enum.EasingStyle.Quint), {Size = UDim2.new(1,-24,0,0)})
                task.delay(0.23, function() dropdownFrame.Visible = false end)
            end

            local function openDropdown()
                dropdownFrame.Visible = true
                local contentHeight = math.min(#values * 34 + 8, 200) -- max ~6 items visible
                Tween(dropdownFrame, TweenInfo.new(0.28, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
                    Size = UDim2.new(1,-24,0,contentHeight)
                })
            end

            -- Build options
            for _, val in ipairs(values) do
                local opt = New("TextButton", {
                    Size = UDim2.new(1,0,0,30),
                    BackgroundTransparency = 1,
                    Text = tostring(val),
                    TextColor3 = Color3.new(1,1,1),
                    Font = Enum.Font.Gotham,
                    TextSize = 13,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    Parent = dropdownFrame,
                }, {
                    New("UIPadding", {PaddingLeft = UDim.new(0,12)}),
                })

                opt.MouseEnter:Connect(function()
                    Tween(opt, nil, {BackgroundTransparency = 0.85})
                end)
                opt.MouseLeave:Connect(function()
                    Tween(opt, nil, {BackgroundTransparency = 1})
                end)

                opt.MouseButton1Click:Connect(function()
                    selectedValue = val
                    display.Text = tostring(val)
                    closeDropdown()
                    if cfg.Callback then cfg.Callback(val) end
                end)
            end

            -- Toggle dropdown
            display.MouseButton1Click:Connect(function()
                if dropdownFrame.Visible then
                    closeDropdown()
                else
                    -- close other open dropdowns first
                    for _, dd in pairs(Library.OpenDropdowns) do
                        if dd ~= dropdownFrame then
                            Tween(dd, TweenInfo.new(0.18), {Size = UDim2.new(1,-24,0,0)})
                            task.delay(0.19, function() dd.Visible = false end)
                        end
                    end
                    openDropdown()
                end
            end)

            -- Close when clicking outside
            local conn
            conn = uis.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    local mousePos = uis:GetMouseLocation()
                    local absPos, absSize = dropdownFrame.AbsolutePosition, dropdownFrame.AbsoluteSize
                    local displayPos, displaySize = display.AbsolutePosition, display.AbsoluteSize

                    local inDropdown = mousePos.X >= absPos.X and mousePos.X <= absPos.X + absSize.X and
                                       mousePos.Y >= absPos.Y and mousePos.Y <= absPos.Y + absSize.Y

                    local inDisplay = mousePos.X >= displayPos.X and mousePos.X <= displayPos.X + displaySize.X and
                                      mousePos.Y >= displayPos.Y and mousePos.Y <= displayPos.Y + displaySize.Y

                    if dropdownFrame.Visible and not inDropdown and not inDisplay then
                        closeDropdown()
                    end
                end
            end)

            -- Cleanup when destroyed (optional)
            el.Frame.AncestryChanged:Connect(function()
                if not el.Frame:IsDescendantOf(Library.GUI) then
                    conn:Disconnect()
                end
            end)

            return {
                Value = function() return selectedValue end,
                Set = function(v)
                    if table.find(values, v) then
                        selectedValue = v
                        display.Text = tostring(v)
                    end
                end
            }
        end

        return api
    end

    return win
end

function Library:CreateWindow(cfg)
    local w = CreateWindow(cfg)
    table.insert(Library.Windows, w)
    return w
end

-- Floating Minimizer
function Library:CreateMinimizer(cfg)
    cfg = cfg or {}

    local holder = New("Frame", {
        Name = "Minimizer",
        Size = cfg.Size or UDim2.fromOffset(60,60),
        Position = cfg.Position or UDim2.new(0,320,0,24),
        BackgroundTransparency = 1,
        ZIndex = 9999,
        Parent = Library.GUI,
    })

    local btn = New("ImageButton", {
        Size = UDim2.fromScale(1,1),
        BackgroundColor3 = Color3.fromRGB(28,28,36),
        Image = cfg.Icon or "rbxassetid://100445510581838",
        Parent = holder,
    }, {
        New("UICorner", {CornerRadius = UDim.new(0, cfg.Corner or 16)}),
        New("UIStroke", {Color = Color3.fromRGB(90,140,255), Thickness = 2, Transparency = 0.5}),
    })

    if cfg.Acrylic then
        New("Frame", {
            Size = UDim2.fromScale(1,1),
            BackgroundColor3 = Color3.fromRGB(40,40,55),
            BackgroundTransparency = cfg.Transparency or 0.7,
            ZIndex = -1,
            Parent = btn,
        }, {New("UICorner", {CornerRadius = UDim.new(0, cfg.Corner or 16)})})
    end

    btn.MouseButton1Click:Connect(function()
        if Library.Windows[1] and Library.Windows[1].Root then
            local wf = Library.Windows[1].Root
            wf.Visible = not wf.Visible

            if wf.Visible then
                wf.Size = UDim2.fromOffset(0,0)
                Tween(wf, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
                    Size = UDim2.fromOffset(560,380)
                })
            end
        end
    end)

    -- Dragging for minimizer
    local dragging, dragStart, startPos
    btn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = holder.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then dragging = false end
            end)
        end
    end)

    uis.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            holder.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)

    return holder
end

return Library
