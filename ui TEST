-- Fluent Lite - Dropdown styled exactly like your screenshot
-- "Select Weapon" + selected value big in center + ▼ on right

local Library = {
    Theme   = "Dark",
    GUI     = Instance.new("ScreenGui", game:GetService("Players").LocalPlayer:WaitForChild("PlayerGui")),
    Windows = {},
    OpenDropdowns = {},
}

Library.GUI.ResetOnSpawn = false
Library.GUI.Name = "FluentLite"

local Themes = {
    Dark = {
        Accent        = Color3.fromRGB(100, 180, 255),
        Background    = Color3.fromRGB(22, 22, 28),
        Element       = Color3.fromRGB(32, 32, 38),
        Border        = Color3.fromRGB(60, 60, 75),
        Text          = Color3.fromRGB(235, 235, 245),
        SubText       = Color3.fromRGB(160, 160, 180),
        Hover         = Color3.fromRGB(45, 45, 55),
        DropdownBg    = Color3.fromRGB(25, 25, 32),
    }
}

local ts = game:GetService("TweenService")
local uis = game:GetService("UserInputService")

local function New(class, props, children)
    local o = Instance.new(class)
    for k,v in pairs(props or {}) do
        if k ~= "Parent" then o[k] = v end
    end
    for _,c in ipairs(children or {}) do c.Parent = o end
    if props and props.Parent then o.Parent = props.Parent end
    return o
end

local function Tween(obj, info, goals)
    ts:Create(obj, info or TweenInfo.new(0.25, Enum.EasingStyle.Quint), goals):Play()
end

local function ApplyTheme(obj, props)
    local t = Themes[Library.Theme] or Themes.Dark
    for p,c in pairs(props or {}) do
        if t[c] then obj[p] = t[c] end
    end
end

-- Element base
local function CreateElement(title, desc, parent)
    local frame = New("TextButton", {
        Size = UDim2.new(1,0,0,0),
        AutoButtonColor = false,
        BackgroundTransparency = 0.92,
        Parent = parent,
    }, {
        New("UICorner", {CornerRadius = UDim.new(0,6)}),
        New("UIStroke", {Transparency=0.65, ApplyStrokeMode = Enum.ApplyStrokeMode.Border}),
    })

    ApplyTheme(frame,      {BackgroundColor3="Element"})
    ApplyTheme(frame.UIStroke, {Color="Border"})

    local holder = New("Frame", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1,-16,1,0),
        Position = UDim2.fromOffset(8,0),
        Parent = frame
    }, {
        New("UIListLayout", {Padding = UDim.new(0,4), SortOrder = Enum.SortOrder.LayoutOrder})
    })

    local lblTitle = New("TextLabel", {
        Text = title or "",
        Font = Enum.Font.GothamSemibold,
        TextSize = 14,
        BackgroundTransparency = 1,
        Size = UDim2.new(1,0,0,20),
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = holder,
    })

    local lblDesc = New("TextLabel", {
        Text = desc or "",
        Font = Enum.Font.Gotham,
        TextSize = 12,
        TextColor3 = Color3.fromRGB(170,170,190),
        BackgroundTransparency = 1,
        Size = UDim2.new(1,0,0,0),
        AutomaticSize = Enum.AutomaticSize.Y,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextWrapped = true,
        Parent = holder,
    })

    ApplyTheme(lblTitle, {TextColor3="Text"})
    ApplyTheme(lblDesc,  {TextColor3="SubText"})

    frame.Size = UDim2.new(1,0,0, holder.UIListLayout.AbsoluteContentSize.Y + 16)

    return {
        Frame    = frame,
        SetTitle = function(t) lblTitle.Text = t end,
        SetDesc  = function(d) lblDesc.Text = d end,
        Visible  = function(v) frame.Visible = v end,
    }
end

-- Window (minimal version for demo)
local function CreateWindow(cfg)
    local win = {
        Title = cfg.Title or "Fluent Lite",
        Root = nil,
    }

    local root = New("Frame", {
        Size = cfg.Size or UDim2.fromOffset(560, 380),
        Position = UDim2.new(0.5, -280, 0.5, -190),
        BackgroundColor3 = Color3.fromRGB(20,20,26),
        Parent = Library.GUI,
    }, {
        New("UICorner", {CornerRadius = UDim.new(0,10)}),
        New("UIStroke", {Color = Color3.fromRGB(50,50,70), Thickness = 1.5}),
    })

    win.Root = root

    local titleBar = New("Frame", {Size = UDim2.new(1,0,0,36), BackgroundTransparency = 1, Parent = root})

    New("TextLabel", {
        Text = win.Title,
        Font = Enum.Font.GothamBold,
        TextSize = 15,
        TextColor3 = Color3.new(1,1,1),
        BackgroundTransparency = 1,
        Size = UDim2.new(1,-80,1,0),
        Position = UDim2.fromOffset(14,0),
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = titleBar,
    })

    local closeBtn = New("TextButton", {
        Size = UDim2.fromOffset(28,28),
        Position = UDim2.new(1,-34,0,4),
        BackgroundTransparency = 0.9,
        Text = "×",
        Font = Enum.Font.GothamBold,
        TextSize = 18,
        TextColor3 = Color3.fromRGB(255,100,100),
        Parent = titleBar,
    }, {New("UICorner", {CornerRadius=UDim.new(0,6)})})

    closeBtn.MouseButton1Click:Connect(function()
        Library.GUI:Destroy()
    end)

    local contentArea = New("Frame", {
        Size = UDim2.new(1, -24, 1, -44),
        Position = UDim2.fromOffset(12, 40),
        BackgroundTransparency = 1,
        Parent = root
    }, {
        New("UIListLayout", {Padding = UDim.new(0,10), SortOrder = Enum.SortOrder.LayoutOrder}),
    })

    function win:AddDropdown(cfg)
        local values   = cfg.Values or {}
        local default  = cfg.Default or (values[1] or "Select...")
        local callback = cfg.Callback or function() end

        local el = CreateElement(cfg.Text or "Select", cfg.Desc or "", contentArea)

        -- Dropdown button (big selected value in center, arrow right)
        local btn = New("TextButton", {
            Size = UDim2.new(1,-24,0,38),
            Position = UDim2.fromOffset(12,0),
            BackgroundTransparency = 0.88,
            Text = tostring(default),
            TextColor3 = Color3.new(1,1,1),
            Font = Enum.Font.GothamBold,
            TextSize = 16,  -- bigger text like in screenshot
            Parent = el.Frame,
        }, {
            New("UICorner", {CornerRadius = UDim.new(0,8)}),
            New("UIStroke", {Transparency = 0.6, ApplyStrokeMode = Enum.ApplyStrokeMode.Border}),
            New("TextLabel", {  -- ▼ arrow on right
                Size = UDim2.fromOffset(24,24),
                Position = UDim2.new(1,-32,0.5,0),
                AnchorPoint = Vector2.new(1,0.5),
                BackgroundTransparency = 1,
                Text = "▼",
                TextColor3 = Color3.fromRGB(180,180,200),
                Font = Enum.Font.GothamBold,
                TextSize = 16,
            })
        })

        ApplyTheme(btn,      {BackgroundColor3 = "Element"})
        ApplyTheme(btn.UIStroke, {Color = "Border"})

        -- Dropdown list container
        local dropList = New("Frame", {
            Size = UDim2.new(1,-24,0,0),
            Position = UDim2.new(0,12,1,8),
            BackgroundTransparency = 0.1,
            Visible = false,
            ClipsDescendants = true,
            Parent = el.Frame,
        }, {
            New("UICorner", {CornerRadius = UDim.new(0,8)}),
            New("UIStroke", {Transparency = 0.55, ApplyStrokeMode = Enum.ApplyStrokeMode.Border}),
            New("UIListLayout", {Padding = UDim.new(0,2), SortOrder = Enum.SortOrder.LayoutOrder}),
            New("UIPadding", {PaddingTop = UDim.new(0,4), PaddingBottom = UDim.new(0,4)}),
        })

        ApplyTheme(dropList,      {BackgroundColor3 = "DropdownBg"})
        ApplyTheme(dropList.UIStroke, {Color = "Border"})

        local current = default

        for _, val in ipairs(values) do
            local opt = New("TextButton", {
                Size = UDim2.new(1,0,0,32),
                BackgroundTransparency = 1,
                Text = tostring(val),
                TextColor3 = Color3.new(1,1,1),
                Font = Enum.Font.GothamSemibold,
                TextSize = 15,
                TextXAlignment = Enum.TextXAlignment.Center,  -- centered text
                Parent = dropList,
            })

            opt.MouseEnter:Connect(function()
                Tween(opt, TweenInfo.new(0.15), {BackgroundTransparency = 0.85})
            end)
            opt.MouseLeave:Connect(function()
                Tween(opt, TweenInfo.new(0.15), {BackgroundTransparency = 1})
            end)

            opt.MouseButton1Click:Connect(function()
                current = val
                btn.Text = tostring(val)
                Tween(dropList, TweenInfo.new(0.22), {Size = UDim2.new(1,-24,0,0)})
                task.delay(0.23, function() dropList.Visible = false end)
                if callback then callback(val) end
            end)
        end

        local function toggle()
            if dropList.Visible then
                Tween(dropList, TweenInfo.new(0.22), {Size = UDim2.new(1,-24,0,0)})
                task.delay(0.23, function() dropList.Visible = false end)
            else
                for _, dd in pairs(Library.OpenDropdowns) do
                    if dd ~= dropList then
                        Tween(dd, TweenInfo.new(0.18), {Size = UDim2.new(1,-24,0,0)})
                        task.delay(0.19, function() dd.Visible = false end)
                    end
                end

                dropList.Visible = true
                local h = math.min(#values * 36 + 12, 240)
                Tween(dropList, TweenInfo.new(0.28, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
                    Size = UDim2.new(1,-24,0,h)
                })
            end
        end

        btn.MouseButton1Click:Connect(toggle)

        local conn = uis.InputBegan:Connect(function(inp)
            if inp.UserInputType ~= Enum.UserInputType.MouseButton1 and inp.UserInputType ~= Enum.UserInputType.Touch then return end

            local mouse = uis:GetMouseLocation()
            local dPos, dSize = dropList.AbsolutePosition, dropList.AbsoluteSize
            local bPos, bSize = btn.AbsolutePosition, btn.AbsoluteSize

            local inDrop = mouse.X >= dPos.X and mouse.X <= dPos.X + dSize.X and
                           mouse.Y >= dPos.Y and mouse.Y <= dPos.Y + dSize.Y

            local inBtn = mouse.X >= bPos.X and mouse.X <= bPos.X + bSize.X and
                          mouse.Y >= bPos.Y and mouse.Y <= bPos.Y + bSize.Y

            if dropList.Visible and not inDrop and not inBtn then
                toggle()
            end
        end)

        el.Frame.AncestryChanged:Connect(function(_, p)
            if p == nil then conn:Disconnect() end
        end)

        return {
            Frame = el.Frame,
            Value = function() return current end,
            Set = function(v)
                if table.find(values, v) then
                    current = v
                    btn.Text = tostring(v)
                end
            end
        }
    end

    return win
end

function Library:CreateWindow(cfg)
    local w = CreateWindow(cfg)
    table.insert(Library.Windows, w)
    return w
end

return Library
